<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#06384b">
  <title>دليل الأسماك | FATYAK</title>

  <style>
    :root {
      --navy: #07384b;
      --navy-deep: #052b3d;
      --teal: #087b84;
      --aqua: #65d7c6;
      --gold: #ffd487;
      --ink: #17394a;
      --muted: #6e8490;
      --line: #e5edf0;
      --paper: #ffffff;
      --bg: #f3f7f8;
      --shadow: 0 16px 40px rgba(16, 55, 73, .09);
      --radius: 22px;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      background:
        radial-gradient(circle at 7% 18%, rgba(185, 232, 224, .35), transparent 24rem),
        var(--bg);
      font-family: system-ui, -apple-system, "Segoe UI", Tahoma, Arial, sans-serif;
    }

    button, input { font: inherit; }

    a { color: inherit; }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 22px max(20px, calc((100vw - 1190px) / 2)) 112px;
      color: #fff;
      background:
        radial-gradient(circle at 84% 15%, rgba(101, 215, 198, .18), transparent 20rem),
        linear-gradient(125deg, #052d41 0%, #07546a 67%, #087b84 100%);
      border-radius: 0 0 38px 38px;
    }

    .hero::before,
    .hero::after {
      position: absolute;
      content: "";
      pointer-events: none;
      border: 1px solid rgba(255, 255, 255, .10);
      border-radius: 50%;
    }

    .hero::before {
      width: 440px;
      height: 440px;
      top: -260px;
      left: -115px;
      box-shadow: 0 0 0 32px rgba(255,255,255,.025), 0 0 0 75px rgba(255,255,255,.02);
    }

    .hero::after {
      width: 200px;
      height: 200px;
      bottom: -153px;
      right: 39%;
      box-shadow: 0 0 0 24px rgba(255,255,255,.025), 0 0 0 54px rgba(255,255,255,.02);
    }

    .topbar,
    .hero-inner {
      position: relative;
      z-index: 1;
      max-width: 1190px;
      margin-inline: auto;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-mark {
      display: grid;
      width: 54px;
      height: 54px;
      place-items: center;
      flex: 0 0 auto;
      border: 1px solid rgba(255, 255, 255, .22);
      border-radius: 18px;
      background: rgba(255, 255, 255, .12);
      box-shadow: 0 8px 22px rgba(0, 0, 0, .12);
    }

    .brand-mark svg { width: 42px; height: 42px; }

    .brand-name {
      font-weight: 900;
      font-size: 20px;
      letter-spacing: 2px;
    }

    .brand-subtitle {
      margin-top: 2px;
      color: rgba(255,255,255,.68);
      font-size: 10px;
      letter-spacing: 2px;
      direction: ltr;
      text-align: right;
    }

    .developer-tag {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 13px;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 999px;
      color: rgba(255,255,255,.78);
      background: rgba(255,255,255,.08);
      font-size: 12px;
    }

    .developer-tag strong {
      color: var(--gold);
      letter-spacing: 1px;
    }

    .hero-inner {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 36px;
      margin-top: 58px;
    }

    .hero-copy { max-width: 760px; }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 15px;
      color: #b7f2e8;
      font-size: 13px;
      font-weight: 700;
    }

    .eyebrow-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--aqua);
      box-shadow: 0 0 0 5px rgba(101,215,198,.14);
    }

    h1 {
      margin: 0;
      max-width: 760px;
      font-size: clamp(32px, 5vw, 55px);
      line-height: 1.28;
      letter-spacing: -.8px;
    }

    .hero-description {
      max-width: 680px;
      margin: 17px 0 0;
      color: rgba(255,255,255,.76);
      font-size: 15px;
      line-height: 1.9;
    }

    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      min-width: 290px;
    }

    .hero-stat {
      min-width: 91px;
      padding: 13px 14px;
      border: 1px solid rgba(255,255,255,.16);
      border-radius: 16px;
      background: rgba(255,255,255,.075);
      backdrop-filter: blur(6px);
    }

    .hero-stat strong {
      display: block;
      color: #fff;
      font-size: 20px;
      line-height: 1.2;
    }

    .hero-stat span {
      display: block;
      margin-top: 5px;
      color: rgba(255,255,255,.68);
      font-size: 11px;
    }

    .container {
      position: relative;
      z-index: 2;
      width: min(1190px, calc(100% - 36px));
      margin: -62px auto 0;
    }

    .search-panel {
      padding: 20px;
      border: 1px solid rgba(221, 233, 237, .9);
      border-radius: 23px;
      background: var(--paper);
      box-shadow: var(--shadow);
    }

    .search-top {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .search-box {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      min-height: 54px;
      padding: 0 15px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: #f8fbfc;
      transition: border-color .2s, box-shadow .2s;
    }

    .search-box:focus-within {
      border-color: #6dcfc1;
      box-shadow: 0 0 0 4px rgba(101, 215, 198, .14);
    }

    .search-icon {
      width: 20px;
      height: 20px;
      flex: 0 0 auto;
      color: #78909b;
    }

    .search-box input {
      width: 100%;
      min-width: 0;
      border: 0;
      outline: 0;
      color: var(--ink);
      background: transparent;
      font-size: 14px;
    }

    .search-box input::placeholder { color: #91a2aa; }

    .clear-button {
      padding: 5px 8px;
      border: 0;
      border-radius: 8px;
      color: #728893;
      background: transparent;
      cursor: pointer;
      font-size: 12px;
      white-space: nowrap;
    }

    .clear-button:hover { background: #eaf2f3; }

    .filter-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 15px;
    }

    .filter-label {
      margin-inline-end: 3px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
    }

    .filter-button {
      padding: 8px 13px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: #58717e;
      background: #fff;
      cursor: pointer;
      font-size: 12px;
      transition: .18s ease;
    }

    .filter-button:hover {
      border-color: #9cdacf;
      color: var(--teal);
    }

    .filter-button.active {
      border-color: var(--navy);
      color: #fff;
      background: var(--navy);
      box-shadow: 0 5px 12px rgba(7, 56, 75, .14);
    }

    .search-note {
      margin: 13px 2px 0;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.8;
    }

    .results-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 15px;
      margin: 28px 2px 16px;
    }

    .results-heading h2 {
      margin: 0;
      color: var(--ink);
      font-size: 21px;
    }

    .results-heading p {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 12px;
    }

    .result-count {
      padding: 8px 12px;
      border: 1px solid #dce9eb;
      border-radius: 999px;
      color: #52717d;
      background: #fff;
      font-size: 12px;
      white-space: nowrap;
    }

    .fish-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      align-items: stretch;
    }

    .fish-card {
      display: block;
      overflow: hidden;
      min-width: 0;
      border: 1px solid #e4ecef;
      border-radius: 19px;
      color: inherit;
      background: var(--paper);
      box-shadow: 0 7px 22px rgba(22, 57, 74, .045);
      text-decoration: none;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .fish-card:hover {
      transform: translateY(-5px);
      border-color: #c5e4df;
      box-shadow: 0 16px 32px rgba(22, 57, 74, .11);
    }

    .fish-card:focus-visible,
    .filter-button:focus-visible,
    .clear-button:focus-visible,
    .modal-close:focus-visible {
      outline: 3px solid rgba(34, 163, 149, .45);
      outline-offset: 3px;
    }

    .photo-frame {
      position: relative;
      overflow: hidden;
      aspect-ratio: 1.62;
      background: #0b4052;
    }

    .fish-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .4s ease;
    }

    .fish-card:hover .fish-image { transform: scale(1.045); }

    .photo-shade {
      position: absolute;
      inset: 45% 0 0;
      pointer-events: none;
      background: linear-gradient(transparent, rgba(3, 28, 43, .22));
    }

    .risk-badge {
      position: absolute;
      top: 11px;
      left: 11px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      max-width: calc(100% - 22px);
      padding: 7px 10px;
      border: 1px solid rgba(255,255,255,.56);
      border-radius: 999px;
      color: #24424e;
      background: rgba(255,255,255,.94);
      box-shadow: 0 4px 12px rgba(0,0,0,.1);
      font-size: 10px;
      font-weight: 800;
    }

    .risk-badge::before {
      width: 7px;
      height: 7px;
      flex: 0 0 auto;
      border-radius: 50%;
      background: #259270;
      content: "";
    }

    .risk-medium::before { background: #e6a52a; }
    .risk-high::before { background: #e16b46; }
    .risk-extreme::before { background: #b83243; }

    .group-badge {
      position: absolute;
      right: 11px;
      bottom: 11px;
      padding: 5px 9px;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 999px;
      color: #fff;
      background: rgba(5, 39, 55, .65);
      backdrop-filter: blur(5px);
      font-size: 10px;
    }

    .card-body { padding: 15px 15px 14px; }

    .card-title {
      margin: 0;
      color: #173a4a;
      font-size: 18px;
      font-weight: 850;
      line-height: 1.5;
    }

    .french-name {
      display: block;
      margin-top: 2px;
      color: #378a8d;
      font-size: 12px;
      font-weight: 650;
    }

    .scientific-name {
      display: block;
      margin-top: 5px;
      color: #82949c;
      direction: ltr;
      text-align: right;
      font-size: 10px;
      font-style: italic;
    }

    .card-benefit {
      display: -webkit-box;
      overflow: hidden;
      min-height: 43px;
      margin: 11px 0 12px;
      color: #607782;
      font-size: 11px;
      line-height: 1.85;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .card-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding-top: 11px;
      border-top: 1px solid #edf2f4;
    }

    .protein-summary {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .protein-summary span {
      color: #7c909a;
      font-size: 10px;
    }

    .protein-summary strong {
      color: #0b6872;
      font-size: 14px;
    }

    .protein-summary small {
      color: #7c909a;
      font-size: 9px;
      font-weight: 500;
    }

    .card-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #087b84;
      font-size: 11px;
      font-weight: 750;
      white-space: nowrap;
    }

    .card-link span {
      font-size: 17px;
      transition: transform .2s;
    }

    .fish-card:hover .card-link span { transform: translateX(-3px); }

    .empty-state {
      grid-column: 1 / -1;
      padding: 42px 20px;
      border: 1px dashed #cadbdd;
      border-radius: 20px;
      color: #66808a;
      background: rgba(255,255,255,.7);
      text-align: center;
    }

    .empty-state strong {
      display: block;
      margin-bottom: 7px;
      color: var(--ink);
      font-size: 17px;
    }

    .important-note {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 13px;
      margin: 25px 0 35px;
      padding: 17px 19px;
      border: 1px solid #e4e8d6;
      border-radius: 17px;
      background: #fbfbf3;
    }

    .note-icon {
      display: grid;
      width: 34px;
      height: 34px;
      place-items: center;
      border-radius: 11px;
      color: #89641f;
      background: #fff0c9;
      font-weight: 900;
    }

    .important-note strong {
      display: block;
      margin-bottom: 4px;
      color: #665329;
      font-size: 12px;
    }

    .important-note p {
      margin: 0;
      color: #74694d;
      font-size: 11px;
      line-height: 1.9;
    }

    footer {
      padding: 20px;
      border-top: 1px solid #e4ecee;
      color: #738891;
      background: rgba(255,255,255,.55);
      text-align: center;
      font-size: 11px;
      line-height: 1.8;
    }

    footer strong {
      color: #0a6070;
      letter-spacing: 1px;
    }

    /* نافذة معلومات السمكة */
    .fish-dialog {
      width: min(900px, calc(100vw - 24px));
      max-width: 900px;
      max-height: calc(100vh - 24px);
      padding: 0;
      overflow: visible;
      border: 0;
      border-radius: 25px;
      background: transparent;
    }

    .fish-dialog::backdrop {
      background: rgba(3, 25, 39, .69);
      backdrop-filter: blur(5px);
    }

    .modal-card {
      position: relative;
      overflow-y: auto;
      max-height: calc(100vh - 24px);
      border: 1px solid rgba(255,255,255,.55);
      border-radius: 25px;
      background: #fff;
      box-shadow: 0 28px 90px rgba(0,0,0,.3);
    }

    .modal-top {
      display: grid;
      grid-template-columns: minmax(240px, .92fr) 1.08fr;
      min-height: 255px;
      background: linear-gradient(130deg, #f5fbfb, #edf6f5);
    }

    .modal-photo {
      position: relative;
      overflow: hidden;
      min-height: 255px;
      background: #0b4052;
    }

    .modal-photo img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .modal-heading {
      align-self: center;
      padding: 28px 30px;
    }

    .modal-overline {
      margin-bottom: 11px;
      color: #278b89;
      font-size: 11px;
      font-weight: 800;
    }

    .modal-heading h2 {
      margin: 0;
      color: var(--navy);
      font-size: clamp(25px, 4vw, 36px);
      line-height: 1.4;
    }

    .modal-french {
      margin-top: 5px;
      color: #218187;
      font-size: 15px;
      font-weight: 700;
    }

    .modal-scientific {
      margin-top: 7px;
      color: #728790;
      direction: ltr;
      text-align: right;
      font-size: 12px;
      font-style: italic;
    }

    .modal-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
    }

    .modal-pill {
      padding: 8px 11px;
      border: 1px solid #dceae9;
      border-radius: 999px;
      color: #38606c;
      background: rgba(255,255,255,.8);
      font-size: 11px;
    }

    .modal-pill.protein {
      border-color: #bfe5dd;
      color: #08716c;
      background: #e8f7f2;
      font-weight: 800;
    }

    .modal-close {
      position: absolute;
      z-index: 3;
      top: 13px;
      right: 13px;
      display: grid;
      width: 38px;
      height: 38px;
      place-items: center;
      border: 1px solid rgba(255,255,255,.7);
      border-radius: 50%;
      color: #264550;
      background: rgba(255,255,255,.94);
      box-shadow: 0 4px 12px rgba(0,0,0,.1);
      cursor: pointer;
      font-size: 22px;
      line-height: 1;
    }

    .modal-main { padding: 20px 24px 24px; }

    .photo-credit {
      min-height: 19px;
      margin: 0 0 14px;
      color: #87969c;
      font-size: 10px;
      line-height: 1.7;
    }

    .photo-credit a {
      color: #32818a;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .info-block {
      padding: 16px;
      border: 1px solid #e6edef;
      border-radius: 16px;
      background: #fbfdfd;
    }

    .info-block h3 {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 8px;
      color: #245160;
      font-size: 13px;
    }

    .info-block h3::before {
      width: 7px;
      height: 7px;
      border-radius: 3px;
      background: #49bdaa;
      content: "";
    }

    .info-block p {
      margin: 0;
      color: #58717c;
      font-size: 12px;
      line-height: 1.9;
    }

    .info-block p + p { margin-top: 6px; }

    .info-block b { color: #315462; }

    .micro-note {
      color: #87969c !important;
      font-size: 10px !important;
    }

    .safety-callout {
      margin-top: 13px;
      padding: 16px 17px;
      border: 1px solid #f0e3c5;
      border-radius: 16px;
      background: #fffbf1;
    }

    .safety-callout.risk-low {
      border-color: #d7ece3;
      background: #f3fbf7;
    }

    .safety-callout.risk-medium {
      border-color: #f0e3c5;
      background: #fffbf1;
    }

    .safety-callout.risk-high {
      border-color: #f3d9d0;
      background: #fff7f4;
    }

    .safety-callout.risk-extreme {
      border-color: #efcbd0;
      background: #fff4f5;
    }

    .safety-callout h3 {
      margin: 0 0 7px;
      color: #715c31;
      font-size: 13px;
    }

    .safety-callout p {
      margin: 0;
      color: #6f6a59;
      font-size: 12px;
      line-height: 1.9;
    }

    .safety-callout p + p { margin-top: 7px; }

    @media (max-width: 1050px) {
      .fish-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .hero-inner { align-items: start; flex-direction: column; }
      .hero-stats { min-width: 0; }
    }

    @media (max-width: 760px) {
      .hero { padding-bottom: 100px; }
      .fish-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .modal-top { grid-template-columns: 1fr; }
      .modal-photo { min-height: 220px; max-height: 270px; }
      .modal-heading { padding: 20px 22px 22px; }
    }

    @media (max-width: 520px) {
      .hero {
        padding-inline: 17px;
        padding-top: 17px;
        border-radius: 0 0 27px 27px;
      }

      .brand-mark { width: 47px; height: 47px; border-radius: 15px; }
      .brand-mark svg { width: 37px; height: 37px; }
      .brand-name { font-size: 17px; }
      .developer-tag { gap: 6px; padding: 8px 10px; font-size: 10px; }
      .hero-inner { margin-top: 40px; gap: 22px; }
      .hero-description { font-size: 13px; }
      .hero-stat { min-width: 82px; padding: 10px 11px; }
      .hero-stat strong { font-size: 17px; }
      .container { width: min(100% - 22px, 1190px); margin-top: -55px; }
      .search-panel { padding: 14px; border-radius: 19px; }
      .search-top { gap: 8px; }
      .filter-row { gap: 6px; }
      .filter-button { padding: 7px 10px; font-size: 10px; }
      .filter-label { width: 100%; }
      .fish-grid { gap: 11px; }
      .fish-card { border-radius: 15px; }
      .card-body { padding: 11px 11px 12px; }
      .card-title { font-size: 15px; }
      .french-name { font-size: 10px; }
      .card-benefit { min-height: 39px; font-size: 10px; }
      .risk-badge { top: 7px; left: 7px; padding: 6px 8px; font-size: 9px; }
      .group-badge { right: 7px; bottom: 7px; font-size: 9px; }
      .card-link { font-size: 10px; }
      .results-heading h2 { font-size: 18px; }
      .results-heading p { font-size: 10px; }
      .result-count { padding: 7px 9px; font-size: 10px; }
      .detail-grid { grid-template-columns: 1fr; }
      .modal-main { padding: 16px; }
      .important-note { padding: 14px; }
    }

    @media (max-width: 370px) {
      .fish-grid { grid-template-columns: 1fr; }
      .photo-frame { aspect-ratio: 1.8; }
      .developer-tag span { display: none; }
    }
  </style>
</head>

<body>
  <header class="hero">
    <nav class="topbar" aria-label="رأس الموقع">
      <div class="brand">
