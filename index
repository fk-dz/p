    function cardTemplate(fish) {
      const proteinUnit = fish.protein === null ? "لا توجد قيمة ثابتة" : "غ بروتين / 100 غ";
      return `
        <a class="fish-card" href="#fish-details" data-open-id="${escapeHTML(fish.id)}"
           aria-label="عرض تفاصيل ${escapeHTML(fish.ar)}، ${escapeHTML(fish.fr)}">
          <div class="photo-frame">
            <img class="fish-image"
                 data-fish-id="${escapeHTML(fish.id)}"
                 src="${makeFishIllustration(fish.color)}"
                 alt="رسم توضيحي لسمكة ${escapeHTML(fish.ar)}">
            <div class="photo-shade"></div>
            <span class="risk-badge risk-${escapeHTML(fish.risk)}">${escapeHTML(riskLabel(fish))}</span>
