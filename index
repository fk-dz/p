          fish.diet,
          fish.benefits,
          fish.vitamins,
          fish.danger,
          fish.advice,
          riskLabel(fish)
        ].join(" "));

        return searchable.includes(query);
      });

      resultCount.textContent = `عرض ${filtered.length} من ${fishData.length} نوعًا`;

      if (filtered.length) {
        fishGrid.innerHTML = filtered.map(cardTemplate).join("");
        observeGridPhotos();
      } else {
        fishGrid.innerHTML = `
          <div class="empty-state">
            <strong>لم نعثر على نتيجة</strong>
            جرّب اسمًا آخر بالعربية أو الفرنسية، أو امسح البحث والتصفية.
          </div>`;
        if (photoObserver) photoObserver.disconnect();
      }
    }

    function observeGridPhotos() {
      if (photoObserver) photoObserver.disconnect();

      const images = [...fishGrid.querySelectorAll("img[data-fish-id]")];

      if (!("IntersectionObserver" in window)) {
        images.forEach(loadFishPhoto);
        return;
      }

      photoObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            observer.unobserve(entry.target);
            loadFishPhoto(entry.target);
          }
        });
      }, { rootMargin: "250px 0px" });

      images.forEach(image => photoObserver.observe(image));
    }

    function plainTextFromHTML(value) {
      const doc = new DOMParser().parseFromString(String(value || ""), "text/html");
      return (doc.body.textContent || "").replace(/\s+/g, " ").trim();
    }

    async function requestCommonsPhoto(fish) {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 9000);

      try {
        const params = new URLSearchParams({
          action: "query",
          generator: "search",
          gsrsearch: fish.imageSearch,
          gsrnamespace: "6",
          gsrlimit: "5",
          prop: "info|imageinfo",
          inprop: "url",
          iiprop: "url|extmetadata",
          iiurlwidth: "900",
          format: "json",
          origin: "*"
        });

        const response = await fetch(
          "https://commons.wikimedia.org/w/api.php?" + params.toString(),
          { signal: controller.signal }
        );

        if (!response.ok) return null;

        const data = await response.json();
        const pages = Object.values(data?.query?.pages || {})
          .filter(page => page.imageinfo && page.imageinfo.length)
          .sort((a, b) => (a.index || 999) - (b.index || 999));

        if (!pages.length) return null;

        const page = pages[0];
        const image = page.imageinfo[0];
        const metadata = image.extmetadata || {};

        const license = plainTextFromHTML(metadata.LicenseShortName?.value || "");
        const artist = plainTextFromHTML(metadata.Artist?.value || "").slice(0, 110);

        return {
          url: image.thumburl || image.url,
          pageUrl: page.fullurl || page.canonicalurl || "",
          license,
          artist,
          fileName: page.title || ""
        };
      } catch (error) {
        return null;
      } finally {
        clearTimeout(timeout);
      }
    }

    function getCommonsPhoto(fish) {
      if (!photoCache.has(fish.id)) {
        photoCache.set(fish.id, requestCommonsPhoto(fish));
      }
      return photoCache.get(fish.id);
    }

    function updatePhotoCredit(fishId, photo) {
      const credits = document.querySelectorAll(`[data-credit-id="${fishId}"]`);

      credits.forEach(credit => {
        if (!photo) {
          credit.textContent = "تعذّر تحميل الصورة الفوتوغرافية؛ تظهر الرسمة البديلة.";
          return;
        }

        const link = document.createElement("a");
        link.href = photo.pageUrl || "https://commons.wikimedia.org/";
        link.target = "_blank";
        link.rel = "noopener noreferrer";

        const parts = ["Wikimedia Commons"];
        if (photo.artist) parts.push(photo.artist);
        if (photo.license) parts.push("الرخصة: " + photo.license);
        else parts.push("تفاصيل الرخصة في صفحة الملف");

        link.textContent = "مصدر الصورة: " + parts.join(" · ");
        credit.replaceChildren(link);
      });
    }

    async function loadFishPhoto(imageElement) {
      if (!imageElement || imageElement.dataset.photoStarted === "true") return;

      imageElement.dataset.photoStarted = "true";
      const fish = fishData.find(item => item.id === imageElement.dataset.fishId);
      if (!fish) return;

      const photo = await getCommonsPhoto(fish);

      if (!photo || !photo.url) {
        updatePhotoCredit(fish.id, null);
        return;
      }

      updatePhotoCredit(fish.id, photo);

      if (!imageElement.isConnected) return;

      imageElement.onerror = function () {
        this.onerror = null;
        this.src = makeFishIllustration(fish.color);
      };
      imageElement.alt = `صورة لسمكة ${fish.ar} — ${fish.fr}`;
      imageElement.src = photo.url;
    }

    function openFishDetails(id) {
      const fish = fishData.find(item => item.id === id);
      if (!fish) return;

      const proteinNote = fish.proteinNote
        ? `<p class="micro-note">${escapeHTML(fish.proteinNote)}</p>`
        : "";

      fishDialog.innerHTML = `
        <div class="modal-card">
          <button class="modal-close" type="button" aria-label="إغلاق النافذة">×</button>

          <div class="modal-top">
            <div class="modal-photo">
              <img class="fish-image"
                   data-fish-id="${escapeHTML(fish.id)}"
                   src="${makeFishIllustration(fish.color)}"
                   alt="رسم توضيحي لسمكة ${escapeHTML(fish.ar)}">
              <span class="risk-badge risk-${escapeHTML(fish.risk)}">${escapeHTML(riskLabel(fish))}</span>
            </div>

            <div class="modal-heading">
              <div class="modal-overline">FATYAK · دليل الأسماك</div>
              <h2 id="detailTitle">${escapeHTML(fish.ar)}</h2>
              <div class="modal-french">${escapeHTML(fish.fr)}</div>
              <div class="modal-scientific">${escapeHTML(fish.scientific)}</div>
              <div class="modal-pills">
                <span class="modal-pill">${escapeHTML(fish.group)}</span>
                <span class="modal-pill protein">
                  ${fish.protein === null
                    ? "البروتين: لا توجد قيمة موحدة"
                    : `البروتين التقريبي: ≈ ${escapeHTML(fish.protein)} غ / 100 غ`}
                </span>
              </div>
            </div>
          </div>

          <div class="modal-main">
            <p class="photo-credit" data-credit-id="${escapeHTML(fish.id)}">
              يجري البحث عن صورة من Wikimedia Commons…
            </p>

            <div class="detail-grid">
              <section class="info-block">
                <h3>على ماذا تتغذى؟</h3>
                <p>${escapeHTML(fish.diet)}</p>
              </section>

              <section class="info-block">
                <h3>فوائدها الغذائية</h3>
                <p>${escapeHTML(fish.benefits)}</p>
              </section>

              <section class="info-block">
                <h3>البروتين والفيتامينات</h3>
                <p><b>البروتين:</b> ${fish.protein === null
                  ? "لا توجد قيمة موحدة لجميع أنواعها."
                  : `نحو ${escapeHTML(fish.protein)} غ لكل 100 غ تقريبًا.`}</p>
                <p><b>الفيتامينات والعناصر:</b> ${escapeHTML(fish.vitamins)}</p>
                ${proteinNote}
              </section>

              <section class="info-block">
                <h3>مجموعة السمك</h3>
                <p>${escapeHTML(fish.group)} — ${escapeHTML(fish.scientific)}</p>
              </section>
            </div>

            <section class="safety-callout risk-${escapeHTML(fish.risk)}">
              <h3>هل هي خطيرة على الإنسان؟ — ${escapeHTML(riskLabel(fish))}</h3>
              <p>${escapeHTML(fish.danger)}</p>
              <p><b>إرشاد:</b> ${escapeHTML(fish.advice)}</p>
            </section>
          </div>
        </div>`;

      fishDialog.showModal();

      fishDialog.querySelector(".modal-close").addEventListener("click", () => {
        fishDialog.close();
      });

      loadFishPhoto(fishDialog.querySelector("img[data-fish-id]"));
    }

    fishGrid.addEventListener("click", event => {
      const card = event.target.closest("[data-open-id]");
      if (!card) return;
      event.preventDefault();
      openFishDetails(card.dataset.openId);
    });

    fishDialog.addEventListener("click", event => {
      if (event.target === fishDialog) fishDialog.close();
    });

    searchInput.addEventListener("input", renderFish);

    clearSearch.addEventListener("click", () => {
      searchInput.value = "";
      searchInput.focus();
      renderFish();
    });

    document.querySelectorAll(".filter-button").forEach(button => {
      button.addEventListener("click", () => {
        activeFilter = button.dataset.filter;

        document.querySelectorAll(".filter-button").forEach(item => {
          const selected = item === button;
          item.classList.toggle("active", selected);
          item.setAttribute("aria-pressed", String(selected));
        });

        renderFish();
      });
    });

    renderFish();
  </script>
</body>
</html>
